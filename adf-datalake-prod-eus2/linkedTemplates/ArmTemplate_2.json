{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-datalake-prod-eus2"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DF_Rejected_Duplicate_records_in_seperate_table')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_AzureSQL_Source_Credit_Score_CTE",
								"type": "DatasetReference"
							},
							"name": "CreditScoreTable"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Azure_SQL_Sink_Rejected_records",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "RowNumberGenerate",
							"description": "Assigned the row number to each records"
						},
						{
							"name": "DuplicateRecords",
							"description": "Filter : Shows duplicate records"
						},
						{
							"name": "SelectColumns",
							"description": "Remove row_number column."
						},
						{
							"name": "SortedData",
							"description": "Sorting rows on columns 'Credit_ID' in Ascending order"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Credit_ID as integer,",
						"          Card_Type as string,",
						"          Credit_Name as string,",
						"          Credit_score as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table',",
						"     partitionBy('hash', 1)) ~> CreditScoreTable",
						"CreditScoreTable window(over(Card_Type,",
						"          Credit_Name,",
						"          Credit_score),",
						"     desc(Credit_ID, true),",
						"     Row_number = rowNumber(),",
						"     partitionBy('hash', 1)) ~> RowNumberGenerate",
						"RowNumberGenerate filter(greaterOrEqual(Row_number,2),",
						"     partitionBy('hash', 1)) ~> DuplicateRecords",
						"DuplicateRecords select(mapColumn(",
						"          Credit_ID,",
						"          Card_Type,",
						"          Credit_Name,",
						"          Credit_score",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectColumns",
						"SelectColumns sort(asc(Credit_ID, true),",
						"     partitionBy('hash', 1)) ~> SortedData",
						"SortedData sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          Credit_ID as integer,",
						"          Card_Type as string,",
						"          Credit_Name as string,",
						"          Credit_score as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     recreate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     partitionBy('hash', 1)) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_TopMost_DuplicatedRejected_AllCleanedData')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_AzureSQL_Source_Credit_Score_CTE",
								"type": "DatasetReference"
							},
							"name": "CredtiScoreTableDetails"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Azure_SQL_Sink_Rejected_records",
								"type": "DatasetReference"
							},
							"name": "RejectedDuplicatedRecords",
							"description": "Rejected Duplicated Records in rejected Table.\nExport data to DS_Azure_SQL_Sink_Rejected_records"
						},
						{
							"dataset": {
								"referenceName": "DS_AzureSQL_Sink_TopMost",
								"type": "DatasetReference"
							},
							"name": "TopMostCreditScoreData"
						},
						{
							"dataset": {
								"referenceName": "DS_Azure_SQL_Sink_All_Cust_Records",
								"type": "DatasetReference"
							},
							"name": "LoadedAllCleanData"
						}
					],
					"transformations": [
						{
							"name": "windowsRowNumGenerate",
							"description": "TO generate row number"
						},
						{
							"name": "DuplicateValuesFilter",
							"description": "show duplicate records \nLogic = rownum >1"
						},
						{
							"name": "select1",
							"description": "select with columns 'Credit_ID, Card_Type, Credit_Name, Credit_score' only\nRemove rownum column"
						},
						{
							"name": "SortedData"
						},
						{
							"name": "UniqueRecords",
							"description": "Fetched unique records.\nrownumber = 1"
						},
						{
							"name": "SelectedColumns",
							"description": "Fetched columns except rownumber column"
						},
						{
							"name": "windowsFunction",
							"description": "Fetched Rank(), DenseRank() \nRowNumber()."
						},
						{
							"name": "sortedBasedOnDenseRank",
							"description": "Sorted based on DenseRank in Asc order\n"
						},
						{
							"name": "TopMostRecords",
							"description": "Conditional Split:\nTopers credit score in Toppers Table.\nAll data in All customer table\n"
						},
						{
							"name": "SelectOnly4Columns",
							"description": "Renaming TopMostRecords@TopMost to SelectOnly4Columns with columns 'Credit_ID, Card_Type, Credit_Name, Credit_score"
						},
						{
							"name": "selectAllData"
						},
						{
							"name": "sortedAllData",
							"description": "Sorting rows on columns 'Credit_ID "
						}
					],
					"scriptLines": [
						"source(output(",
						"          Credit_ID as integer,",
						"          Card_Type as string,",
						"          Credit_Name as string,",
						"          Credit_score as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table',",
						"     partitionBy('hash', 1)) ~> CredtiScoreTableDetails",
						"CredtiScoreTableDetails window(over(Card_Type,",
						"          Credit_Name,",
						"          Credit_score),",
						"     asc(Credit_ID, true),",
						"     Row_Number = rowNumber(),",
						"     partitionBy('hash', 1)) ~> windowsRowNumGenerate",
						"windowsRowNumGenerate filter(greaterOrEqual(Row_Number,2),",
						"     partitionBy('hash', 1)) ~> DuplicateValuesFilter",
						"DuplicateValuesFilter select(mapColumn(",
						"          Credit_ID,",
						"          Card_Type,",
						"          Credit_Name,",
						"          Credit_score",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 sort(asc(Credit_ID, true),",
						"     partitionBy('hash', 1)) ~> SortedData",
						"windowsRowNumGenerate filter(equals(Row_Number,1),",
						"     partitionBy('hash', 1)) ~> UniqueRecords",
						"UniqueRecords select(mapColumn(",
						"          Credit_ID,",
						"          Card_Type,",
						"          Credit_Name,",
						"          Credit_score",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectedColumns",
						"SelectedColumns window(over(Card_Type),",
						"     desc(Credit_score, true),",
						"     Rank = rank(),",
						"          DenseRank = denseRank(),",
						"          Rownumber = rowNumber(),",
						"     partitionBy('hash', 1)) ~> windowsFunction",
						"windowsFunction sort(asc(DenseRank, true),",
						"     partitionBy('hash', 1)) ~> sortedBasedOnDenseRank",
						"sortedBasedOnDenseRank split(equals(DenseRank,1),",
						"     disjoint: false) ~> TopMostRecords@(TopMost, AllCustomers)",
						"TopMostRecords@TopMost select(mapColumn(",
						"          Credit_ID,",
						"          Card_Type,",
						"          Credit_Name,",
						"          Credit_score",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectOnly4Columns",
						"sortedAllData select(mapColumn(",
						"          Credit_ID,",
						"          Card_Type,",
						"          Credit_Name,",
						"          Credit_score",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectAllData",
						"TopMostRecords@AllCustomers sort(asc(Credit_ID, true),",
						"     partitionBy('hash', 1)) ~> sortedAllData",
						"SortedData sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          Credit_ID as integer,",
						"          Card_Type as string,",
						"          Credit_Name as string,",
						"          Credit_score as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     recreate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     partitionBy('hash', 1)) ~> RejectedDuplicatedRecords",
						"SelectOnly4Columns sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     recreate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     partitionBy('hash', 1)) ~> TopMostCreditScoreData",
						"selectAllData sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     partitionBy('hash', 1)) ~> LoadedAllCleanData"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Snowflake_to_ADLSGen2')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Snowflake to ADLSGen2",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SnowflakeV2Source",
								"exportSettings": {
									"type": "SnowflakeExportCopyCommand"
								}
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".csv"
								}
							},
							"enableStaging": true,
							"stagingSettings": {
								"linkedServiceName": {
									"referenceName": "LS_Blob_Snow",
									"type": "LinkedServiceReference"
								},
								"path": "bronze"
							},
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "DS_SnowFlake",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_SnowFlake_to_ADLSGen2",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Nested_For_Each_Folders_Master_PL')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Get Folders",
						"description": "Get folders from ADLSGen2 - Bronze container.",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "Nested_ForEach_DS",
								"type": "DatasetReference",
								"parameters": {}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "Iterate_folders",
						"description": "For each activity is going to iterate one by one folders",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Get Folders",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Get Folders').output.childItems",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "call_child_pipeline",
									"description": "calling child pipeline to iterate items or files inside folders",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "Nested_For_Each_Files_Child_PL",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"ppFolderName": {
												"value": "@item().name",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_WindowsFunctionTransformation')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "CreditScore_Data",
						"description": "Calling the data flow which is transforming the Tope most credit score customer records, Duplicate rejected records and all customers data.",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DF_TopMost_DuplicatedRejected_AllCleanedData",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"CredtiScoreTableDetails": {},
									"RejectedDuplicatedRecords": {},
									"TopMostCreditScoreData": {},
									"LoadedAllCleanData": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/DF_TopMost_DuplicatedRejected_AllCleanedData')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Windows_Transform_Pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "DF_Remove_duplicate",
						"description": "Call DF_Remove_Duplicate_records data flow",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DF_Rejected_Duplicate_records_in_seperate_table",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"CreditScoreTable": {},
									"sink1": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/DF_Rejected_Duplicate_records_in_seperate_table')]"
			]
		}
	]
}