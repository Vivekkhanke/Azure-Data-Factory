{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name"
		},
		"LS_Azure_SQL_Source": {
			"type": "string"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Windows_Transform_Pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "DF_Remove_duplicate",
						"description": "Call DF_Remove_Duplicate_records data flow",
						"type": "ExecuteDataFlow",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "DF_Rejected_Duplicate_records_in_seperate_table",
								"type": "DataFlowReference"
							},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/DF_Rejected_Duplicate_records_in_seperate_table')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Rejected_Duplicate_records_in_seperate_table')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_AzureSQL_Source_Credit_Score_CTE",
								"type": "DatasetReference"
							},
							"name": "CreditScoreTable"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Azure_SQL_Sink_Rejected_records",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "RowNumberGenerate",
							"description": "Assigned the row number to each records"
						},
						{
							"name": "DuplicateRecords",
							"description": "Filter : Shows duplicate records"
						},
						{
							"name": "SelectColumns",
							"description": "Remove row_number column."
						},
						{
							"name": "SortedData",
							"description": "Sorting rows on columns 'Credit_ID' in Ascending order"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Credit_ID as integer,",
						"          Card_Type as string,",
						"          Credit_Name as string,",
						"          Credit_score as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table',",
						"     partitionBy('hash', 1)) ~> CreditScoreTable",
						"CreditScoreTable window(over(Card_Type,",
						"          Credit_Name,",
						"          Credit_score),",
						"     desc(Credit_ID, true),",
						"     Row_number = rowNumber(),",
						"     partitionBy('hash', 1)) ~> RowNumberGenerate",
						"RowNumberGenerate filter(greaterOrEqual(Row_number,2),",
						"     partitionBy('hash', 1)) ~> DuplicateRecords",
						"DuplicateRecords select(mapColumn(",
						"          Credit_ID,",
						"          Card_Type,",
						"          Credit_Name,",
						"          Credit_score",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectColumns",
						"SelectColumns sort(asc(Credit_ID, true),",
						"     partitionBy('hash', 1)) ~> SortedData",
						"SortedData sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          Credit_ID as integer,",
						"          Card_Type as string,",
						"          Credit_Name as string,",
						"          Credit_score as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     recreate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     partitionBy('hash', 1)) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_AzureSQL_Source_Credit_Score_CTE')]",
				"[concat(variables('factoryId'), '/datasets/DS_Azure_SQL_Sink_Rejected_records')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_AzureSQL_Source_Credit_Score_CTE')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('LS_Azure_SQL_Source')]",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "Credit_ID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "Card_Type",
						"type": "nvarchar"
					},
					{
						"name": "Credit_Name",
						"type": "nvarchar"
					},
					{
						"name": "Credit_score",
						"type": "int",
						"precision": 10
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "CreditScore"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_Azure_SQL_Sink_Rejected_records')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('LS_Azure_SQL_Source')]",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "Credit_ID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "Card_Type",
						"type": "nvarchar"
					},
					{
						"name": "Credit_Name",
						"type": "nvarchar"
					},
					{
						"name": "Credit_score",
						"type": "int",
						"precision": 10
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "rejected_records"
				}
			},
			"dependsOn": []
		}
	]
}